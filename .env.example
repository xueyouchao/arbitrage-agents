NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/arbitrage_agents
# Optional maintenance database used by npm run test:integration to create/drop disposable test databases.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
LOG_LEVEL=info

# Sentry observability (optional but recommended)
SENTRY_DSN=
SENTRY_MONITOR_SLUG=arbitrage-agents-scan
SENTRY_SEND_DEFAULT_PII=false
# 0 = no traces (free tier), 0.1 = 10% of spans, 1 = all spans
SENTRY_TRACES_SAMPLE_RATE=0
LLM_PROMPT_SAMPLE_RATE=0

# LLM configuration (Ollama-compatible)
# Set to true to enable LLM-assisted market matching
LLM_ENABLED=false
# Ollama API endpoint (local or remote)
LLM_BASE_URL=http://127.0.0.1:11434/api/chat
LLM_MODEL=glm-5.2:cloud
LLM_PROVIDER=ollama
LLM_REQUEST_TIMEOUT_MS=30000
SCANNER_LLM_PROMPT_VERSION=scanner-v1
SCANNER_LLM_MAX_EVALUATIONS_PER_SCAN=25

# Worker configuration
# Minutes between scan iterations (default: 15; non-positive/non-finite falls back to 15)
WORKER_SCAN_INTERVAL_MINUTES=15
# Max ms to wait for an in-flight scan to finish during graceful shutdown before
# proceeding to tear down the context anyway (default: 30000). Bounded so the
# worker exits within Docker's stop grace even if a scan hangs.
WORKER_SHUTDOWN_TIMEOUT_MS=30000

# Production deployment (docker-compose)
# These are used by docker-compose.yml, NOT by the app directly.
# DB_USER and DB_NAME are read by docker-compose for Postgres init.
DB_USER=arbitrage_user
DB_NAME=arbitrage
# REQUIRED: set a strong password before deploying
DB_PASSWORD=
API_PORT=3000
# Ollama base URL accessible from Docker containers
OLLAMA_BASE_URL=http://host.docker.internal:11434
# API keys for future multi-provider LLM support (not yet wired)
DASHSCOPE_API_KEY=
OPENROUTER_API_KEY=

# Kalshi trading API (optional — leave empty for read-only/scanner-only operation)
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY=

# Risk management (issue #81)
# Max capital deployed across all open positions (USD). New executions are
# rejected when total open position notional + requested notional exceeds this.
MAX_CAPITAL_DEPLOYED_USD=5000

# Execution freshness guards (issue #82)
# Fail-closed pre-flight rejection of stale quotes and aged opportunities before
# any order is submitted. Set to a positive number of milliseconds to enable a
# guard; 0 or empty disables it and preserves the prior no-guard behavior.
MAX_QUOTE_STALENESS_MS=0
MAX_OPPORTUNITY_AGE_MS=0

# Crypto price-level scanner series. Crypto daily price-level markets only
# surface via series-scoped queries — without these the worker fetches each
# venue's generic top-100 (which contains ~no crypto price-level markets) and
# emits 0 candidate pairs every scan. Override to scan ETH or set empty to
# fall back to the global top-100 (legacy behavior).
KALSHI_SERIES_TICKER=KXBTCD
POLYMARKET_SERIES_SLUG=btc-multi-strikes-weekly
# Cross-venue deadline matching tolerance. Default 60 s exact, plus 24 h relaxed
# window for crypto price-level markets. Increase to admit near-expiry pairs.
DEADLINE_TOLERANCE_MS=60000
CRYPTO_DEADLINE_RELAXED_TOLERANCE_MS=86400000

# PMXT hosted shadow evaluation (disabled by default; read-only PMXT tables only)
PMXT_API_KEY=
PMXT_HOSTED_BASE_URL=
PMXT_SHADOW_ENABLED=false
PMXT_SHADOW_READS_ENABLED=false
PMXT_SHADOW_ROUTER_ENABLED=false
PMXT_SHADOW_SAMPLE_RATE=0/1
PMXT_SHADOW_TIMEOUT_MS=60000
PMXT_REQUEST_TIMEOUT_MS=10000
PMXT_SHADOW_REQUESTS_PER_MINUTE=60
PMXT_SHADOW_MAX_CONCURRENCY=1
PMXT_SHADOW_MAX_QUEUE_DEPTH=
PMXT_SHADOW_MAX_QUEUE_WAIT_MS=
PMXT_SHADOW_MAX_REQUESTS_PER_RUN=
PMXT_SHADOW_MAX_MARKETS_PER_VENUE=
PMXT_SHADOW_MAX_BOOKS_PER_VENUE=
PMXT_SHADOW_MAX_MONTHLY_CREDITS=
PMXT_SHADOW_MAX_MONTHLY_COST_USD=
PMXT_SHADOW_RAW_RETENTION_DAYS=0

# ADR-0002 T1 conditional settlement exit policy (issue #??)
# §3.3 exit-cost gate and liquidity haircut. Increase minMargin to demand a
# fatter buffer before selling at t1; increase depthHaircut to be more
# conservative about available book depth.
T1_EXIT_MIN_MARGIN=0.005
T1_EXIT_DEPTH_HAIRCUT=0.25
# §3.1/§4.1 policy selector: evaluate | hold. "always" (unconditional exit) is
# intentionally not exposed in phase 1; it is deferred until a future ADR approves it.
T1_EXIT_POLICY=evaluate
# §6 Open Question #1: simple gap-decay proxy for hold expected value.
T1_EXIT_GAP_DECAY_PER_HOUR=0.02
T1_EXIT_GAP_DECAY_MAX=0.5
# §3.3 exit-cost components. SELL_FEE and ESTIMATED_SPREAD are fractions of price;
# ESTIMATED_SLIPPAGE_PER_SHARE is a per-share cost (dollars per share sold) — slippage
# scales with size, not price, per ADR §3.3.
T1_EXIT_SELL_FEE_RATE=0.01
T1_EXIT_ESTIMATED_SPREAD_RATE=0.01
T1_EXIT_ESTIMATED_SLIPPAGE_PER_SHARE=0.005
