# ---- Execution mode ----------------------------------------------------------
# paper = simulator only, no real orders
# live  = real CLOB orders (requires funded Polygon wallet + Kalshi account)
MODE=paper

# ---- Bankroll & risk caps ----------------------------------------------------
BANKROLL_USDC=3000
MAX_TRADE_PCT=0.02          # 2% of bankroll per trade
MAX_OPEN_POSITIONS=3
DAILY_DRAWDOWN_PCT=0.03     # halt at -3% intraday
WEEKLY_MIN_SHARPE=0.5

# ---- Signal model (overridable by weekly agent debate) -----------------------
EDGE_THRESHOLD=0.02         # fair - market must exceed this
VOL_FLOOR_15M=0.003         # 0.3% / 15min floor on realized vol
TAU_FRAC_GATE=0.5           # only trade when τ/T < 0.5 (mid-candle onward)

# ---- CEX feeds ---------------------------------------------------------------
BINANCE_WS=wss://stream.binance.com:9443/ws
COINBASE_WS=wss://ws-feed.exchange.coinbase.com

# ---- Polymarket --------------------------------------------------------------
POLYGON_RPC_URL=https://polygon-rpc.com
POLYGON_RPC_FALLBACK=https://polypulse.com
POLYMARKET_CLOB_URL=https://clob.polymarket.com
POLYMARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
PRIVATE_KEY=                        # 0x... leave blank in paper mode

# ---- Kalshi ------------------------------------------------------------------
KALSHI_API_BASE=https://api.elections.kalshi.com/trade-api/v2
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PEM_PATH=

# ---- Agentic LLM layer (Ollama Cloud via CCR) --------------------------------
# 4 models, fan-out for debate, cheap model for forensics
OLLAMA_BASE_URL=http://127.0.0.1:11434
DEBATE_MODELS=minimax-m3:cloud,deepseek-v4-pro:cloud,glm-5.1:cloud,kimi-k2.6:cloud
FORENSICS_MODEL=deepseek-v4-flash:cloud
REGIME_MODEL=glm-5.1:cloud
LLM_TIMEOUT_MS=12000          # hard cap per call; abort if slower
LLM_MAX_TOKENS=400            # keep outputs small to avoid context bloat

# ---- Operational -------------------------------------------------------------
LOG_LEVEL=info                 # debug | info | warn | error
LOG_PATH=./logs
