{
  "name": "arbitrage-agents",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-venue prediction market arbitrage intelligence scanner",
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start:api": "node dist/main-api.js",
    "start:worker": "node dist/main-worker.js",
    "start:prod:api": "node dist/main-api.js",
    "start:prod:worker": "node dist/main-worker.js",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:acceptance": "bash test/acceptance/run-api-acceptance.sh",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "smoke:sentry-monitor": "node dist/src/sentry-monitor-smoke.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@sentry/node": "^10.58.0",
    "drizzle-orm": "^0.38.4",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.8",
    "@nestjs/testing": "^10.4.15",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "@types/yaml": "^1.9.6",
    "@vitest/coverage-v8": "^2.1.8",
    "drizzle-kit": "^0.31.10",
    "supertest": "^7.2.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "yaml": "^2.9.0"
  },
  "engines": {
    "node": ">=20"
  }
}
