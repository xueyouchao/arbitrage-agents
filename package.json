{
  "name": "arbitrage-agents",
  "version": "0.1.0",
  "private": true,
  "description": "Agentic, dynamic-workflow crypto/prediction-market arbitrage bot. Deterministic hot path, offline multi-model debate layer.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node --enable-source-maps dist/index.js",
    "dev": "tsx watch src/index.ts",
    "paper": "tsx src/index.ts --mode=paper",
    "test": "vitest run",
    "test:watch": "vitest",
    "debate": "tsx scripts/weekly-debate.ts",
    "forensics": "tsx scripts/forensics.ts",
    "regime": "tsx scripts/regime.ts"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "ws": "^8.18.0",
    "undici": "^6.19.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.12",
    "typescript": "^5.5.0",
    "tsx": "^4.19.0",
    "vitest": "^2.1.0"
  }
}
