{
  "name": "arbitrage-agents",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-venue prediction market arbitrage intelligence scanner",
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start:api": "node dist/main-api.js",
    "start:worker": "node dist/main-worker.js",
    "test": "vitest run",
    "test:acceptance": "bash test/acceptance/run-api-acceptance.sh",
    "test:live-smoke": "bash test/acceptance/run-live-market-data-smoke.sh",
    "test:live-smoke:docker": "bash test/acceptance/run-live-market-data-smoke-with-docker.sh",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "drizzle-orm": "^0.38.4",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.8",
    "@nestjs/testing": "^10.4.15",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.20.0",
    "@vitest/coverage-v8": "^2.1.8",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
